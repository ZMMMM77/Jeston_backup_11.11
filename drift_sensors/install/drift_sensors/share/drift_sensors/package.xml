<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drift_sensors</name>
  <version>0.1.0</version>
  <description>Velocity estimation for the drift policy: ICP lidar odometry + D435i IMU -> EKF -> /drift/state_odom.
    Adapted from Roboracer-Final-Project/F1TENTH-EKF/sensors_bringup.</description>
  <maintainer email="nvidia@todo.todo">nvidia</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
